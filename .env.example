# Copy to .env and fill in real values. .env is git-ignored; never put real
# secrets in this file (it is committed).

# ---------- Website (read at build time, bundled into the site) ----------
# Calendly booking page embedded on the contact page and linked from blog articles
VITE_CALENDLY_URL=https://calendly.com/lina-grantready/15-minute-discussion

# ---------- Server-side only (form backend) ----------
# Never prefix these with VITE_ or they would be bundled into the public site.
SENDGRID_API_KEY=SG.xxxxxxxx
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_VERIFY_SID=VAxxxxxxxx

# ---------- Form backend deploy settings (infra/deploy-contact-form.sh) ----------
FORM_TO_EMAILS=lina@grantready.com.au,heather.spencer@grantready.com.au
FORM_FROM_EMAIL=grantguru@grantguru.com
FORM_ALLOWED_ORIGINS=https://d3hkz6lbhj1jks.cloudfront.net,http://localhost:5173

# Set after deploying the backend (printed by the deploy script)
VITE_FORM_ENDPOINT=
